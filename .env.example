# NChat API — Cloudflare Worker backend (see /worker)
# Local dev default is the wrangler dev server; set to your deployed
# Worker URL (https://nchat-api.your-subdomain.workers.dev) once deployed.
VITE_API_URL=http://localhost:8787

# TURN Server Configuration (Recommended for Production)
# Required for reliable voice/video calls behind NAT/firewalls
# Options:
#   1. Metered.ca (Free tier available): https://www.metered.ca/stun-turn
#   2. Twilio Network Traversal: https://www.twilio.com/docs/stun-turn
#   3. Xirsys: https://xirsys.com/
#   4. Self-hosted coturn: https://github.com/coturn/coturn
#
# Example with Metered.ca:
# VITE_TURN_SERVER_URL=turn:global.relay.metered.ca:80
# VITE_TURN_SERVER_USERNAME=your_username
# VITE_TURN_SERVER_CREDENTIAL=your_credential

# VAPID Keys for Web Push Notifications (Optional — must match the ones set
# as Worker secrets via `wrangler secret put VAPID_PUBLIC_KEY` etc.)
VITE_VAPID_PUBLIC_KEY=

# GIPHY API Key (Optional - for GIF support)
VITE_GIPHY_API_KEY=dPsHZdfq4NpdfNRQMLCSGywSZwOUBQe6Z
